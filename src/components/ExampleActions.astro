---
import { statSync } from "node:fs";

interface Props {
  /** Filename in public/examples/, e.g. "headline.ai" */
  file: string;
  /** Filename in src/components/, e.g. "component1.svelte" */
  component: string;
}

const { file, component } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const source = `https://github.com/reuters-graphics/ai2svelte/blob/main/src/components/${component}`;

// Read the size at build time so the label warns before a 20MB download starts.
let size = "";
try {
  const bytes = statSync(new URL(`../../public/examples/${file}`, import.meta.url)).size;
  const kb = bytes / 1024;
  const mb = kb / 1024;
  // Keep a decimal under 10 MB, where rounding to a whole number is misleading.
  size =
    mb >= 10
      ? `${Math.round(mb)} MB`
      : mb >= 1
        ? `${mb.toFixed(1)} MB`
        : `${Math.round(kb)} KB`;
} catch {
  size = "";
}
---

<div class="example-actions">
  <a
    class="act act-source"
    href={source}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View this example's Svelte component on GitHub, opens in a new tab"
  >
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
      ></path>
    </svg>
    <span class="act-label">View</span>
    <code class="act-ext">.svelte</code>
  </a>

  <a
    class="act act-download"
    href={`${base}/examples/${file}`}
    download={file}
    aria-label={`Download the Illustrator file this example was exported from${size ? `, ${size}` : ""}`}
  >
    <svg
      aria-hidden="true"
      width="14"
      height="14"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 2v8m0 0 3-3m-3 3L5 7"></path>
      <path d="M2.5 11.5v1a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-1"></path>
    </svg>
    <span class="act-label">Download</span>
    <code class="act-ext">.ai</code>
    {size && <span class="act-size">{size}</span>}
  </a>
</div>

<style>
  .example-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .act {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    /* Matches the button type on the home page. Geist Mono isn't loaded here —
       these pages ship no webfonts so the graphic renders unblocked — so this
       falls back to the platform mono face. */
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.16px;
    font-weight: 400;
    line-height: 15px;
    letter-spacing: 0.4864px;
    text-decoration: none;
    white-space: nowrap;
    /* The graphics run edge to edge and vary from night photography to white
       studio shots, so each button carries its own contrast. */
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .act:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .act-source {
    border: 1px solid #2b2b2b;
    background: #050505;
    color: #f3f3f3;
  }

  .act-source:hover,
  .act-source:focus-visible {
    border-color: #4a4a4a;
    background: #161616;
  }

  .act-download {
    border: 1px solid #dc4300;
    background: #dc4300;
    color: #fff;
  }

  .act-download:hover,
  .act-download:focus-visible {
    border-color: #f2560d;
    background: #f2560d;
  }

  .act-label {
    text-transform: uppercase;
  }

  .act-ext {
    font-family: inherit;
    font-size: inherit;
    background: none;
    padding: 0;
  }

  .act-size {
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 30rem) {
    .example-actions {
      gap: 6px;
    }

    .act {
      gap: 6px;
      padding: 7px 10px;
    }

    /* The chrome floats over a full-bleed graphic, so on a phone it has to give
       the artwork its width back. The icon and extension still name the action. */
    .act-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .act {
      transition: none;
    }
  }


</style>

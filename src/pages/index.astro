---
const base = "/ai2svelte";

const featuresLead = [
  {
    title: "SNIPPET LAYERS",
    copy:
      "Snippet layers allow you to add dynamic content into the placeholder region you specify. Plug in any Svelte snippet to render custom component.",
    href: `${base}/users/snippets/`,
  },
  {
    title: "TAGGED LAYERS",
    copy:
      "Supercharge your layers with new capabilities using tagged layers. Tagged layers allows layers to behave differently than the usual static layers.",
    href: `${base}/users/tagged-layers/`,
  },
];

const featuresGrid = [
  {
    title: "GUI BASED EXTENSION",
    copy:
      "No more fiddling the docs. The new GUI provides you the exact key value pairs supported by the script.",
    href: `${base}/users/ai2svelte-settings/`,
  },
  {
    title: "CUSTOM FONT MAPPING",
    copy:
      "Now you can directly configure custom fonts inside the plugin without worrying about manually tweaking the styles in the generated component.",
    href: `${base}/users/font-config/`,
  },
  {
    title: "STYLE PRESETS",
    copy: "Apply bundled shadows and animations to any object with one click.",
    href: `${base}/users/styles/`,
  },
  {
    title: "PROFILES",
    copy: "Save and load ai2svelte settings as reusable, shareable profiles.",
    href: `${base}/users/profiles/`,
    wide: true,
  },
  {
    title: "EVENT LISTENERS",
    copy:
      "Hook into onAiMounted and onArtboardChange to drive interactivity as the component mounts or its active breakpoint changes.",
    href: `${base}/users/event-listeners/`,
  },
];

const examples = [
  {
    title: "Headline snippet",
    copy: "Typography and component embed",
    href: `${base}/example1/`,
    image: `${base}/images/graphics/headline-xl.png`,
  },
  {
    title: "Map video",
    copy: "Responsive embed with annotations",
    href: `${base}/example2/`,
    image: `${base}/images/graphics/mapVideo-xl.png`,
  },
  {
    title: "Fire annotations",
    copy: "Tagged overlays with motion assets",
    href: `${base}/example6/`,
    image: `${base}/images/graphics/fire-xl.png`,
  },
  {
    title: "Stock graphic",
    copy: "Responsive image, newsroom polish",
    href: `${base}/example5/`,
    image: `${base}/images/graphics/stock-md.png`,
  },
];

const releases = "https://github.com/reuters-graphics/ai2svelte/releases/";
const repo = "https://github.com/reuters-graphics/ai2svelte/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>ai2svelte — Illustrator graphics to responsive Svelte</title>
    <meta
      name="description"
      content="ai2svelte is a newsroom-focused Illustrator extension for shipping responsive, text-selectable, interactive graphics without redrawing them by hand in code."
    />
  </head>

  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={`${base}/`} aria-label="ai2svelte home">
          <img src={`${base}/images/home/wordmark.svg`} alt="ai2svelte" width="120" height="19.543" />
        </a>
        <nav class="topnav" aria-label="Primary">
          <a class="btn" href={`${base}/docs/`}>READ DOCS</a>
          <a class="btn" href={repo}>GITHUB</a>
        </nav>
      </header>

      <section class="hero">
        <img class="hero-orb" src={`${base}/images/home/hero-orb.png`} alt="" aria-hidden="true" />

        <div class="hero-card">
          <p class="hero-eyebrow">BRING INTERACTIVITY TO ILLUSTRATOR</p>
          <h1>Illustrator graphics to responsive Svelte.</h1>
          <p class="hero-copy">
            ai2svelte is a newsroom-focused Illustrator extension for shipping
            responsive, text-selectable, interactive graphics without redrawing
            them by hand in code.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={releases}>DOWNLOAD EXTENSION</a>
            <a class="btn" href={`${base}/docs/`}>READ DOCS</a>
          </div>
        </div>

        <img
          class="hero-panel"
          src={`${base}/images/home/hero-panel.svg`}
          alt="The ai2svelte panel in Illustrator showing export settings, profiles and font configuration."
        />
      </section>

      <section class="features features-lead">
        {
          featuresLead.map((item) => (
            <article class="card">
              <h2><span class="dot" aria-hidden="true" /><span class="t">{item.title}</span></h2>
              <div class="card-body">
                <p>{item.copy}</p>
                <div class="card-more">
                  <div><a class="btn" href={item.href}>READ MORE</a></div>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <section class="features features-grid">
        {
          featuresGrid.map((item) => (
            <article class:list={["card", { wide: item.wide }]}>
              <h2><span class="dot" aria-hidden="true" /><span class="t">{item.title}</span></h2>
              <div class="card-body">
                <p>{item.copy}</p>
                <div class="card-more">
                  <div><a class="btn" href={item.href}>READ MORE</a></div>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <section class="examples">
        <div class="section-head">
          <h2><span class="dot on" aria-hidden="true" /><span class="t">EXAMPLES</span></h2>
          <div
            class="rule"
            role="scrollbar"
            tabindex="0"
            aria-controls="example-rail"
            aria-orientation="horizontal"
            aria-label="Scroll examples"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <span class="rule-knob" aria-hidden="true"></span>
          </div>
        </div>

        <div
          class="example-rail"
          id="example-rail"
          role="group"
          aria-label="Examples"
          tabindex="0"
        >
          {
            examples.map((item) => (
              <a class="example" href={item.href}>
                <img src={item.image} alt="" />
                <div class="example-meta">
                  <p class="example-title">{item.title}</p>
                  <p class="example-copy">{item.copy}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="outro">
        <img
          class="wordmark"
          src={`${base}/images/home/wordmark-lg.svg`}
          alt=""
          aria-hidden="true"
          width="798.832"
          height="130.099"
        />
        <div class="outro-actions">
          <a class="btn btn-primary" href={releases}>DOWNLOAD EXTENSION</a>
          <a class="btn" href={`${base}/docs/`}>READ DOCS</a>
        </div>
      </section>

      <div class="shell-tail" aria-hidden="true"></div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #050505;
    --hero-bg: #000000;
    --line: #2b2b2b;
    --text: #f3f3f3;
    --muted: #828282;
    --copy: #b9b9b9;
    --orange: #dc4300;
    --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --sans: "Inter", system-ui, -apple-system, Segoe UI, sans-serif;
    --shell: 1180px;
    --pad: 31px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>

<style>
  .shell {
    width: min(var(--shell), 100%);
    margin: 0 auto;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }

  /* ---------- shared button ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-family: var(--mono);
    font-size: 12.16px;
    font-weight: 400;
    line-height: 15px;
    letter-spacing: 0.4864px;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .btn:hover {
    border-color: #4a4a4a;
    background: rgba(255, 255, 255, 0.04);
  }

  .btn-primary {
    border-color: var(--orange);
    background: var(--orange);
    color: #fff;
  }

  .btn-primary:hover {
    border-color: #f2560d;
    background: #f2560d;
  }

  /* ---------- topbar ---------- */

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    padding: 0 21.6px;
    box-shadow: 0 1px 0 var(--line);
  }

  .brand {
    display: block;
    line-height: 0;
  }

  .brand img {
    display: block;
    width: 120px;
    height: 19.543px;
  }

  .topnav {
    display: flex;
    gap: 8px;
  }

  /* ---------- hero ---------- */

  .hero {
    position: relative;
    height: 800px;
    background: var(--hero-bg);
    box-shadow: 0 1px 0 var(--line);
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    pointer-events: none;
  }

  .hero-card {
    position: absolute;
    top: 255px;
    left: 32px;
    width: 638px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--bg);
    filter: drop-shadow(0 32px 32px rgba(0, 0, 0, 0.4));
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--orange);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    letter-spacing: 1.2px;
  }

  h1 {
    margin: 0;
    font-family: var(--mono);
    font-size: 48px;
    font-weight: 300;
    line-height: 53px;
    letter-spacing: -0.0833333em;
    color: var(--text);
  }

  .hero-copy {
    margin: 0;
    color: var(--copy);
    font-size: 14px;
    line-height: 20px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    padding-top: 16px;
  }

  .hero-panel {
    position: absolute;
    top: 69.46px;
    left: 671.907px;
    width: 464px;
    height: 725px;
    display: block;
  }

  /* ---------- feature cards ---------- */

  .features {
    display: grid;
    box-shadow: 0 1px 0 var(--line);
  }

  .features-lead {
    grid-template-columns: repeat(2, 1fr);
  }

  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
    border-left: 1px solid var(--line);
    isolation: isolate;
  }

  .card:first-child {
    border-left: 0;
  }

  .features-lead .card {
    min-height: 277px;
  }

  .features-grid .card {
    min-height: 315px;
  }

  .features-grid .card:nth-child(4) {
    border-top: 1px solid var(--line);
    border-left: 0;
    min-height: 295px;
  }

  .features-grid .card:nth-child(5) {
    border-top: 1px solid var(--line);
    min-height: 295px;
  }

  .card.wide {
    grid-column: span 2;
  }

  .card h2,
  .section-head h2 {
    display: flex;
    height: 12px;
    margin: 0;
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.6px;
  }

  .card h2 {
    align-items: flex-start;
  }

  .section-head h2 {
    align-items: center;
  }

  .card h2 .t,
  .section-head h2 .t {
    display: block;
    color: #fff;
    /* Design trims the title box to cap-height. Geist Mono 500 at 16px/1 puts
       the baseline 13.5px and the cap top 2.14px below the box top, so these
       margins reproduce the trim in engines without `text-box`. */
    margin: -2.14px 0 -2.5px;
    transition: opacity 220ms ease;
  }

  @supports (text-box: trim-both cap alphabetic) {
    .card h2 .t,
    .section-head h2 .t {
      margin: 0;
      text-box: trim-both cap alphabetic;
    }
  }

  .card h2 .t {
    opacity: 0.5;
  }

  .card:hover h2 .t {
    opacity: 1;
  }

  .dot {
    position: relative;
    flex: none;
    width: 0;
    height: 12px;
    margin-right: 0;
    background: var(--orange);
    opacity: 0;
    transition:
      width 220ms ease,
      margin-right 220ms ease,
      opacity 220ms ease,
      box-shadow 220ms ease;
  }

  .card:hover .dot,
  .dot.on {
    width: 12px;
    margin-right: 8px;
    opacity: 1;
    box-shadow:
      0 0 40px 0 var(--orange),
      0 0 12px 0 var(--orange);
  }

  .card-body p {
    margin: 0;
    color: var(--copy);
    font-size: 14px;
    line-height: 20px;
  }

  .card-more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 240ms ease,
      opacity 240ms ease;
  }

  .card-more > div {
    overflow: hidden;
    min-height: 0;
  }

  .card:hover .card-more {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .card-more .btn {
    margin-top: 16px;
  }

  /* ---------- examples ---------- */

  .examples {
    padding: 120px 0;
    box-shadow: 0 1px 0 var(--line);
    overflow: hidden;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
  }

  .rule {
    position: relative;
    flex: none;
    width: 280px;
    height: 2px;
    background: rgba(255, 255, 255, 0.2);
    cursor: grab;
    touch-action: none;
  }

  /* A 2px-tall bar is an unusable pointer target, so grow the hit
     area vertically without disturbing layout. */
  .rule::before {
    content: "";
    position: absolute;
    inset: -14px 0;
  }

  .rule:focus-visible {
    outline: 1px solid var(--orange);
    outline-offset: 6px;
  }

  .rule.is-dragging {
    cursor: grabbing;
  }

  .rule.is-idle {
    cursor: default;
  }

  .rule-knob {
    position: absolute;
    top: 0;
    left: 0;
    width: 63px;
    height: 100%;
    background: var(--orange);
    will-change: transform;
  }

  .rule.is-idle .rule-knob {
    width: 100%;
  }

  .example-rail {
    display: flex;
    gap: 16px;
    margin-top: 120px;
    padding: 0 32px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .example-rail:focus-visible {
    outline: 1px solid var(--orange);
    outline-offset: -1px;
  }

  .example-rail::-webkit-scrollbar {
    display: none;
  }

  .example {
    flex: none;
    width: 322px;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .example img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .example-meta {
    padding: 16px 12px;
    height: 76px;
  }

  .example-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 19px;
    color: var(--text);
  }

  .example-copy {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 17px;
    color: var(--copy);
  }

  .example:hover .example-title {
    color: var(--orange);
  }

  /* ---------- outro ---------- */

  .outro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 80px 32px;
    box-shadow: 0 1px 0 var(--line);
  }

  .shell-tail {
    height: 64px;
  }

  .wordmark {
    display: block;
    width: 798.832px;
    height: 130.099px;
    max-width: 100%;
    user-select: none;
  }

  .outro-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
  }

  /* ---------- responsive ---------- */

  @media (max-width: 1180px) {
    .hero-panel {
      right: 24px;
    }

    .hero-card {
      width: min(639px, calc(100% - 340px));
    }
  }

  @media (max-width: 900px) {
    :root {
      --pad: 20px;
    }

    .hero {
      height: auto;
      padding: 40px 0;
    }

    .hero-orb {
      object-position: center top;
      opacity: 0.55;
    }

    .hero-card,
    .hero-panel {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      transform: none;
    }

    .hero-card {
      width: calc(100% - 40px);
      margin: 180px 20px 0;
    }

    .hero-panel {
      margin: 32px auto 0;
    }

    h1 {
      font-size: 40px;
      line-height: 44px;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid .card:nth-child(3),
    .features-grid .card:nth-child(5) {
      border-top: 1px solid var(--line);
    }

    .features-grid .card:nth-child(3),
    .features-grid .card:nth-child(4) {
      border-left: 0;
    }

    .card.wide {
      grid-column: auto;
    }

    .examples {
      padding: 64px 0 72px;
    }

    .example-rail {
      margin-top: 56px;
    }

    .hero {
      height: auto;
      padding: 72px 0 80px;
    }

    .hero-orb {
      object-position: center top;
    }

    .hero-card {
      position: relative;
      top: auto;
      left: auto;
      z-index: 1;
      transform: none;
      width: auto;
      margin: 0 20px;
    }

    .hero-panel {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      z-index: 1;
      transform: none;
      display: block;
      width: 464px;
      height: auto;
      margin: 48px auto 0;
      max-width: calc(100% - 40px);
    }

    .wordmark {
      width: 100%;
      height: auto;
    }
  }

  @media (max-width: 640px) {
    .topbar {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
    }

    .features-lead,
    .features-grid {
      grid-template-columns: 1fr;
    }

    .features-lead .card,
    .features-grid .card,
    .features-grid .card:nth-child(4),
    .features-grid .card:nth-child(5) {
      min-height: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .features-lead .card:first-child {
      border-top: 0;
    }

    .card-more {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .dot {
      width: 12px;
      margin-right: 8px;
      opacity: 1;
      box-shadow:
        0 0 40px 0 var(--orange),
        0 0 12px 0 var(--orange);
    }

    .card h2 .t {
      opacity: 1;
    }

    h1 {
      font-size: 34px;
      line-height: 38px;
    }

    .hero-actions,
    .outro-actions {
      flex-direction: column;
    }

    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .rule {
      width: 100%;
    }
  }
</style>

<script>
  const rail = document.getElementById("example-rail");
  const track = document.querySelector(".rule");
  const knob = track && track.querySelector(".rule-knob");

  if (rail && track && knob) {
    const CARD_STEP = 338; /* 322 card + 16 gap */
    let maxScroll = 0;
    let travel = 0;
    let lastValue = -1;

    const clamp = (n, min, max) => Math.min(max, Math.max(min, n));

    const behavior = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ? "auto"
        : "smooth";

    const sync = () => {
      const progress = maxScroll > 0 ? rail.scrollLeft / maxScroll : 0;
      knob.style.transform = `translateX(${progress * travel}px)`;

      const value = Math.round(progress * 100);
      if (value !== lastValue) {
        lastValue = value;
        track.setAttribute("aria-valuenow", String(value));
      }
    };

    const measure = () => {
      maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
      travel = Math.max(0, track.clientWidth - knob.offsetWidth);

      const idle = maxScroll < 1;
      track.classList.toggle("is-idle", idle);
      track.setAttribute("tabindex", idle ? "-1" : "0");
      track.setAttribute("aria-disabled", String(idle));
      sync();
    };

    /* ---- drag the knob, or click the track to scrub ---- */
    let grabOffset = 0;

    const scrubTo = (clientX) => {
      if (travel <= 0) return;
      const left = clientX - track.getBoundingClientRect().left - grabOffset;
      rail.scrollLeft = clamp(left / travel, 0, 1) * maxScroll;
    };

    track.addEventListener("pointerdown", (event) => {
      if (maxScroll < 1) return;

      const knobBox = knob.getBoundingClientRect();
      const onKnob =
        event.clientX >= knobBox.left && event.clientX <= knobBox.right;

      grabOffset = onKnob ? event.clientX - knobBox.left : knob.offsetWidth / 2;
      track.setPointerCapture(event.pointerId);
      track.classList.add("is-dragging");
      scrubTo(event.clientX);

      event.preventDefault();
      track.focus();
    });

    track.addEventListener("pointermove", (event) => {
      if (track.hasPointerCapture(event.pointerId)) scrubTo(event.clientX);
    });

    const endDrag = (event) => {
      if (!track.hasPointerCapture(event.pointerId)) return;
      track.releasePointerCapture(event.pointerId);
      track.classList.remove("is-dragging");
    };

    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);

    /* ---- keyboard ---- */
    track.addEventListener("keydown", (event) => {
      const step = {
        ArrowLeft: -CARD_STEP,
        ArrowRight: CARD_STEP,
        PageUp: -rail.clientWidth,
        PageDown: rail.clientWidth,
      }[event.key];

      let left;
      if (step !== undefined) left = rail.scrollLeft + step;
      else if (event.key === "Home") left = 0;
      else if (event.key === "End") left = maxScroll;
      else return;

      event.preventDefault();
      rail.scrollTo({ left: clamp(left, 0, maxScroll), behavior: behavior() });
    });

    rail.addEventListener("scroll", sync, { passive: true });
    new ResizeObserver(measure).observe(rail);
    measure();
  }
</script>

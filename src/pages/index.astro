    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid .card:nth-child(3),
    .features-grid .card:nth-child(5) {
      border-top: 1px solid var(--line);
    }

    .features-grid .card:nth-child(3),
    .features-grid .card:nth-child(4) {
      border-left: 0;
    }

    .card.wide {
      grid-column: auto;
    }

    .examples {
      padding: 64px 0 72px;
    }

    .example-rail {
      margin-top: 56px;
    }

    .hero {
      height: auto;
      padding: 72px 0 80px;
    }

    .hero-orb {
      object-position: center top;
    }

    .hero-card {
      position: relative;
      top: auto;
      left: auto;
      z-index: 1;
      transform: none;
      width: auto;
      margin: 0 20px;
    }

    .hero-panel {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      z-index: 1;
      transform: none;
      display: block;
      width: 464px;
      height: auto;
      margin: 48px auto 0;
      max-width: calc(100% - 40px);
    }
  }

  @media (max-width: 640px) {

---
import { Font } from "astro:assets";
import FluidBackdrop from "../components/fluid/FluidBackdrop.svelte";

// The logotype is Geist Mono 550 with the pairs hand-kerned tight. These
// offsets were fitted against the original artwork and land within ~95% of
// it; they're in em so the mark scales as one piece.
const logotype: [string, number][] = [
  ["a", 0],
  ["i", -0.0774],
  ["2", -0.039],
  ["s", -0.0642],
  ["v", -0.0714],
  ["e", -0.0934],
  ["l", -0.083],
  ["t", -0.2189],
  ["e", -0.0903],
];

const base = "/ai2svelte";

const featuresLead = [
  {
    title: "SNIPPET LAYERS",
    copy:
      "Mark a region of your artwork as a placeholder and render any Svelte snippet inside it: charts, video, 3D, live widgets.",
    href: `${base}/users/snippets/`,
  },
  {
    title: "TAGGED LAYERS",
    copy:
      "Add a tag like :svg, :png or :div to a layer's name to change how it's exported, so one layer becomes vector, another raster, another a scaling HTML box.",
    href: `${base}/users/tagged-layers/`,
  },
];

const featuresGrid = [
  {
    title: "SETTINGS PANEL",
    copy:
      "No more hand-editing settings text blocks. Every option ai2svelte supports is in the panel, with the valid values right there.",
    href: `${base}/users/ai2svelte-settings/`,
  },
  {
    title: "CUSTOM FONT MAPPING",
    copy:
      "Map Illustrator fonts to your site's CSS font stacks once, and every export uses them. No more patching styles by hand in the generated component.",
    href: `${base}/users/font-config/`,
  },
  {
    title: "STYLE PRESETS",
    copy: "Apply built-in shadows and animations to any object in one click.",
    href: `${base}/users/styles/`,
  },
  {
    title: "PROFILES",
    copy: "Save your settings as profiles you can reuse across projects and share with your team.",
    href: `${base}/users/profiles/`,
    wide: true,
  },
  {
    title: "EVENT LISTENERS",
    copy:
      "Use onAiMounted and onArtboardChange to run code when the graphic mounts or switches breakpoints.",
    href: `${base}/users/event-listeners/`,
  },
];

const examples = [
  {
    title: "Headline snippet",
    copy: "A headline component rendered in a snippet layer",
    href: `${base}/example1/`,
    image: `${base}/images/examples/example1.webp`,
  },
  {
    title: "Video snippet",
    copy: "Video placed precisely with a snippet layer",
    href: `${base}/example2/`,
    image: `${base}/images/examples/example2.webp`,
  },
  {
    title: "3D model",
    copy: "A 3D model embedded through a snippet layer",
    href: `${base}/example3/`,
    image: `${base}/images/examples/example3.webp`,
  },
  {
    title: "Before and after",
    copy: "Snippet and PNG layers driving an interactive slider",
    href: `${base}/example4/`,
    image: `${base}/images/examples/example4.webp`,
  },
  {
    title: "Stock graphic",
    copy: "A third-party widget inside a snippet",
    href: `${base}/example5/`,
    image: `${base}/images/examples/example5.webp`,
  },
  {
    title: "Fire annotations",
    copy: "Interactive annotations on a PNG layer",
    href: `${base}/example6/`,
    image: `${base}/images/examples/example6.webp`,
  },
  {
    title: "Dynamic text",
    copy: "Tagged text layers showing live values",
    href: `${base}/example7/`,
    image: `${base}/images/examples/example7.webp`,
  },
];

const releases = "https://github.com/reuters-graphics/ai2svelte/releases/";
const repo = "https://github.com/reuters-graphics/ai2svelte/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="https://graphics.thomsonreuters.com/style-assets/images/logos/favicon/favicon.ico"
      sizes="32x32"
    />
    <script is:inline>
      // Runs before paint so a saved light theme never flashes dark. Shares
      // Starlight's key, so the homepage and docs stay on the same theme.
      try {
        const saved = localStorage.getItem("starlight-theme");
        const light = saved ? saved === "light" : matchMedia("(prefers-color-scheme: light)").matches;
        if (light) document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-inter" preload />
    <title>ai2svelte: Illustrator graphics to responsive Svelte</title>
    <meta
      name="description"
      content="An Illustrator extension from Reuters Graphics that turns artwork into responsive, text-selectable, interactive Svelte components. Built on ai2html."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://reuters-graphics.github.io/ai2svelte/" />
    <meta property="og:title" content="ai2svelte: Illustrator graphics to responsive Svelte" />
    <meta
      property="og:description"
      content="An Illustrator extension from Reuters Graphics that turns artwork into responsive, text-selectable, interactive Svelte components."
    />
    <meta property="og:image" content="https://reuters-graphics.github.io/ai2svelte/images/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://reuters-graphics.github.io/ai2svelte/images/og.png" />
  </head>

  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={`${base}/`} aria-label="ai2svelte home">
          <img src={`${base}/images/home/wordmark.svg`} alt="ai2svelte" width="120" height="20" />
        </a>
        <nav class="topnav" aria-label="Primary">
          <a class="btn" href={`${base}/users/intro/`}>READ DOCS</a>
          <a class="btn" href={repo}>GITHUB</a>
          <button class="btn theme-toggle" type="button" aria-label="Toggle light mode">
            <span class="to-light">LIGHT</span><span class="to-dark">DARK</span>
          </button>
        </nav>
      </header>

      <section class="hero">
        <img class="hero-orb" src={`${base}/images/home/hero-orb.png`} alt="" aria-hidden="true" />

        <div class="hero-card">
          <p class="hero-eyebrow">FROM ILLUSTRATOR TO SVELTE</p>
          <h1>Illustrator graphics to responsive Svelte.</h1>
          <p class="hero-copy">
            Design in Illustrator and export a responsive Svelte component,
            without redrawing anything in code. ai2svelte keeps your text live
            and selectable, adapts across breakpoints, and lets you drop
            interactive components straight into the artwork.
          </p>
          <p class="hero-credit">
            Built by Reuters Graphics on <a href="http://ai2html.org/">ai2html</a>,
            originally created at The New York Times.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={releases}>DOWNLOAD EXTENSION</a>
            <a class="btn" href={`${base}/users/intro/`}>READ DOCS</a>
          </div>
        </div>

        <img
          class="hero-panel"
          src={`${base}/images/home/hero-panel.svg`}
          alt="The ai2svelte panel in Illustrator showing export settings, profiles and font configuration."
        />
      </section>

      <section class="features features-lead">
        {
          featuresLead.map((item) => (
            <article class="card">
              <h2><span class="dot" aria-hidden="true" /><span class="t">{item.title}</span></h2>
              <div class="card-body">
                <p>{item.copy}</p>
                <div class="card-more">
                  <div><a class="btn" href={item.href}>READ MORE</a></div>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <section class="features features-grid">
        {
          featuresGrid.map((item) => (
            <article class:list={["card", { wide: item.wide }]}>
              <h2><span class="dot" aria-hidden="true" /><span class="t">{item.title}</span></h2>
              <div class="card-body">
                <p>{item.copy}</p>
                <div class="card-more">
                  <div><a class="btn" href={item.href}>READ MORE</a></div>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <section class="examples">
        <div class="section-head">
          <h2><span class="dot" aria-hidden="true" /><span class="t">EXAMPLES</span></h2>
          <div
            class="rule"
            role="scrollbar"
            tabindex="0"
            aria-controls="example-rail"
            aria-orientation="horizontal"
            aria-label="Scroll examples"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <span class="rule-knob" aria-hidden="true"></span>
          </div>
        </div>

        <div
          class="example-rail"
          id="example-rail"
          role="group"
          aria-label="Examples"
          tabindex="0"
        >
          {
            examples.map((item) => (
              <a class="example" href={item.href}>
                <img src={item.image} alt="" />
                <div class="example-meta">
                  <p class="example-title">{item.title}</p>
                  <p class="example-copy">{item.copy}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="outro">
        <FluidBackdrop client:visible startColor="#dc4300" />
        <div class="wordmark" aria-hidden="true">
          {
            logotype.map(([char, kern]) => (
              <span style={`margin-left:${kern}em`}>{char}</span>
            ))
          }
        </div>
        <div class="outro-actions">
          <a class="btn btn-primary" href={releases}>DOWNLOAD EXTENSION</a>
          <a class="btn" href={`${base}/docs/`}>READ DOCS</a>
        </div>
      </section>

      <div class="shell-tail" aria-hidden="true"></div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #050505;
    --hero-bg: #000000;
    --line: #2b2b2b;
    --text: #f3f3f3;
    --muted: #828282;
    --copy: #b9b9b9;
    --orange: #dc4300;
    --heading: #fff;
    --hover-line: #4a4a4a;
    --hover-bg: rgba(255, 255, 255, 0.04);
    --track: rgba(255, 255, 255, 0.2);
    --scrim: rgba(5, 5, 5, 0.72);
    --card-shadow: rgba(0, 0, 0, 0.4);
    --mono: var(--font-geist-mono);
    --sans: var(--font-inter);
    --shell: 1180px;
    --pad: 31px;
  }

  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #fafafa;
    --hero-bg: #ffffff;
    --line: #dcdcdc;
    --text: #111111;
    --muted: #a0a0a0;
    --copy: #4a4a4a;
    --heading: #000;
    --hover-line: #b5b5b5;
    --hover-bg: rgba(0, 0, 0, 0.04);
    --track: rgba(0, 0, 0, 0.15);
    --scrim: rgba(250, 250, 250, 0.72);
    --card-shadow: rgba(0, 0, 0, 0.1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>

<style>
  .shell {
    width: min(var(--shell), 100%);
    margin: 0 auto;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }

  /* ---------- shared button ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 15px;
    letter-spacing: 0.5px;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .btn:hover {
    border-color: var(--hover-line);
    background: var(--hover-bg);
  }

  .btn-primary {
    border-color: var(--orange);
    background: var(--orange);
    color: #fff;
  }

  .btn-primary:hover {
    border-color: #f2560d;
    background: #f2560d;
  }

  /* ---------- topbar ---------- */

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    padding: 0 24px;
    box-shadow: 0 1px 0 var(--line);
    position: sticky;
    top: 0px;
    z-index: 2;
    background: var(--bg);
  }

  .brand {
    display: block;
    line-height: 0;
  }

  .brand img {
    display: block;
    width: 120px;
    height: auto;
  }

  .topnav {
    display: flex;
    gap: 8px;
  }

  .theme-toggle {
    cursor: pointer;
  }

  :global([data-theme="light"]) .to-light,
  .to-dark {
    display: none;
  }

  :global([data-theme="light"]) .to-dark {
    display: inline;
  }

  /* The wordmark and moon are white-on-black artwork; inverting them is
     enough for the light theme. The hero panel stays dark, it's a picture of
     the real Illustrator panel. */
  :global([data-theme="light"]) .brand img,
  :global([data-theme="light"]) .hero-orb {
    filter: invert(1);
  }

  /* ---------- hero ---------- */

  .hero {
    position: relative;
    height: 800px;
    background: var(--hero-bg);
    box-shadow: 0 1px 0 var(--line);
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    pointer-events: none;
  }

  .hero-card {
    position: absolute;
    top: 255px;
    left: 32px;
    width: 640px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--bg);
    outline: 1px solid var(--line);
    filter: drop-shadow(0 32px 32px var(--card-shadow));
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--orange);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 0;
    font-family: var(--mono);
    font-size: 48px;
    font-weight: 300;
    line-height: 53px;
    letter-spacing: -0.08em;
    color: var(--text);
  }

  .hero-copy {
    margin: 0;
    color: var(--copy);
    font-size: 14px;
    line-height: 20px;
  }

  .hero-credit {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 16px;
  }

  .hero-credit a {
    text-decoration: underline;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    padding-top: 16px;
  }

  .hero-panel {
    position: absolute;
    top: 70px;
    left: 672px;
    width: 464px;
    height: 725px;
    display: block;
  }

  /* ---------- feature cards ---------- */

  .features {
    display: grid;
    box-shadow: 0 1px 0 var(--line);
  }

  .features-lead {
    grid-template-columns: repeat(2, 1fr);
  }

  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
    border-left: 1px solid var(--line);
    isolation: isolate;
  }

  .card:first-child {
    border-left: 0;
  }

  .features-lead .card {
    min-height: 277px;
  }

  .features-grid .card {
    min-height: 315px;
  }

  .features-grid .card:nth-child(4) {
    border-top: 1px solid var(--line);
    border-left: 0;
    min-height: 295px;
  }

  .features-grid .card:nth-child(5) {
    border-top: 1px solid var(--line);
    min-height: 295px;
  }

  .card.wide {
    grid-column: span 2;
  }

  .card h2,
  .section-head h2 {
    display: flex;
    height: 12px;
    margin: 0;
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
  }

  .card h2 {
    align-items: flex-start;
  }

  .section-head h2 {
    align-items: center;
  }

  .card h2 .t,
  .section-head h2 .t {
    display: block;
    color: var(--heading);
    /* Design trims the title box to cap-height. Geist Mono 500 at 16px/1 puts
       the cap top about 2px below the box top, so these margins reproduce the
       trim in engines without `text-box`, leaving a 12px box to match the dot. */
    margin: -2px 0 -2px;
    transition: opacity 220ms ease;
  }

  @supports (text-box: trim-both cap alphabetic) {
    .card h2 .t,
    .section-head h2 .t {
      margin: 0;
      text-box: trim-both cap alphabetic;
    }
  }

  .card h2 .t {
    opacity: 0.5;
  }

  .card:hover h2 .t {
    opacity: 1;
  }

  .dot {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
    margin-right: 8px;
    background: var(--muted);
    transition:
      background 220ms ease,
      box-shadow 220ms ease;
  }

  /* Desktop lights a dot while its block is hovered; touch screens have no
     hover, so the script lights it by scroll position instead (`.on`). */
  @media (hover: hover) {
    .card:is(:hover, :focus-within) .dot,
    .examples:is(:hover, :focus-within) .dot {
      background: var(--orange);
      box-shadow:
        0 0 40px 0 var(--orange),
        0 0 12px 0 var(--orange);
    }
  }

  @media (hover: none) {
    .dot.on {
      background: var(--orange);
      box-shadow:
        0 0 40px 0 var(--orange),
        0 0 12px 0 var(--orange);
    }
  }

  .card-body p {
    margin: 0;
    color: var(--copy);
    font-size: 14px;
    line-height: 20px;
  }

  .card-more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 240ms ease,
      opacity 240ms ease;
  }

  .card-more > div {
    overflow: hidden;
    min-height: 0;
  }

  .card:hover .card-more {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .card-more .btn {
    margin-top: 16px;
  }

  /* ---------- examples ---------- */

  .examples {
    padding: 120px 0;
    box-shadow: 0 1px 0 var(--line);
    overflow: hidden;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
  }

  .rule {
    position: relative;
    flex: none;
    width: 280px;
    height: 2px;
    background: var(--track);
    cursor: grab;
    touch-action: none;
  }

  /* A 2px-tall bar is an unusable pointer target, so grow the hit
     area vertically without disturbing layout. */
  .rule::before {
    content: "";
    position: absolute;
    inset: -14px 0;
  }

  .rule:focus-visible {
    outline: 1px solid var(--orange);
    outline-offset: 6px;
  }

  .rule.is-dragging {
    cursor: grabbing;
  }

  .rule.is-idle {
    cursor: default;
  }

  .rule-knob {
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 100%;
    background: var(--orange);
    will-change: transform;
  }

  .rule.is-idle .rule-knob {
    width: 100%;
  }

  .example-rail {
    display: flex;
    gap: 16px;
    margin-top: 120px;
    padding: 0 32px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .example-rail.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .example-rail:focus-visible {
    outline: 1px solid var(--orange);
    outline-offset: -1px;
  }

  .example-rail::-webkit-scrollbar {
    display: none;
  }

  .example {
    flex: none;
    width: 322px;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .example img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .example-meta {
    padding: 16px 12px;
  }

  .example-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 19px;
    color: var(--text);
  }

  .example-copy {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 17px;
    color: var(--copy);
  }

  /* ---------- outro ---------- */

  .outro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 80px 32px;
    box-shadow: 0 1px 0 var(--line);
    /* Clips the canvas to the section and keeps its stacking to itself, so
       the backdrop can't escape into the sticky topbar's layer. */
    overflow: hidden;
    isolation: isolate;
    /* The wordmark is live text, so it can't scale itself the way the old
       artwork did. This gives it a width to size against. */
    container-type: inline-size;
  }

  /* Astro gives every island `display: contents`, so the backdrop inside this
     one resolves its position against the section rather than the island. The
     z-index keeps it behind the wordmark and buttons. */
  .outro :global(astro-island) {
    z-index: 0;
  }

  .shell-tail {
    height: 64px;
  }

  .wordmark {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--mono);
    font-weight: 550;
    /* 175px draws the mark at roughly the 800px the artwork used to occupy;
       below that the container query shrinks it to fit. 21cqw sits just under
       100 / the mark's advance width in ems, so it never overflows. */
    font-size: min(175px, 21cqw);
    line-height: 1;
    white-space: nowrap;
    /* Trims the half-leading above and below so the box hugs the letterforms,
       the way the artwork's own bounds did, and the section's gaps stay put. */
    margin: -0.14em 0 -0.13em;
    user-select: none;
    /* Sits at the same value the flat artwork was drawn in, and warms to
       white while the cursor is anywhere in the section. */
    color: var(--line);
    transition: color 420ms ease;
    /* Decorative, and the simulation reads pointer moves off its own canvas,
       so letting the cursor through keeps the fluid responding across the
       whole section rather than dying over the wordmark. */
    pointer-events: none;
  }

  /* Each letter is its own box so the pair kerning can be applied as a
     margin. */
  .wordmark span {
    display: inline-block;
  }

  .outro:hover .wordmark {
    color: var(--heading);
  }

  .outro-actions {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 16px;
  }

  /* The dye runs straight through this row, so the outline button needs a
     ground of its own to stay readable against it. */

      opacity: 0.55;
    }

    .hero-card,
    .hero-panel {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      transform: none;
    }

    .hero-card {
      width: calc(100% - 40px);
      margin: 180px 20px 0;
    }


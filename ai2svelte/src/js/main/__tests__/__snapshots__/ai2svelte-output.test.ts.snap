<script>
	let { assetsPath = '/', onAiMounted = null, onArtboardChange = null, slot, artboardWidth = $bindable(undefined), lazyMargin = '50% 50%', lazyRoot = null } = $props();

	import { onMount, untrack } from 'svelte';

	let processedPath = $derived(
		assetsPath.replace(new RegExp('/([^/.]+)$'), '/$1/') || '/',
	);

	let aiBox;
	let screenWidth = $state(0);
	let aiBoxWidth = $derived(artboardWidth ?? screenWidth);
	let activeArtboard = $state(undefined);
	let seen = $state({});
	let io;
	const pending = new Set();

	function lazy(el) {
		io ??= new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						seen[e.target.id] = true;
						pending.delete(e.target);
						io.unobserve(e.target);
					}
				}
			},
			{ root: lazyRoot, rootMargin: lazyMargin },
		);
		pending.add(el);
		io.observe(el);
		return () => {
			pending.delete(el);
			io.unobserve(el);
		};
	}

	// load these images now (an id or an array of ids), e.g. when a clipping
	// ancestor stops lazyMargin from loading them ahead of the screen
	export function reveal(ids) {
		for (const id of [ids].flat()) seen[id] = true;
		for (const el of pending) {
			if (seen[el.id]) {
				pending.delete(el);
				io.unobserve(el);
			}
		}
	}

	// reveal() pending images within lazyMargin of the viewport (or lazyRoot),
	// by their real position: unlike the observer, it ignores clipping
	// ancestors. Call it whenever the graphic moves, e.g. each frame of a pan
	export function check() {
		const [t, r = t, b = t, l = r] = lazyMargin.trim().split(/\\s+/);
		const box = lazyRoot?.getBoundingClientRect() ?? {
			left: 0, top: 0, right: innerWidth, bottom: innerHeight,
			width: innerWidth, height: innerHeight,
		};
		const px = (v, size) =>
			v.endsWith('%') ? (parseFloat(v) / 100) * size : parseFloat(v);
		const ids = [];
		for (const el of pending) {
			const q = el.getBoundingClientRect();
			// zero size: display:none (an inactive artboard), never loads
			if (!q.width && !q.height) continue;
			if (
				q.bottom >= box.top - px(t, box.height) &&
				q.left <= box.right + px(r, box.width) &&
				q.top <= box.bottom + px(b, box.height) &&
				q.right >= box.left - px(l, box.width)
			)
				ids.push(el.id);
		}
		reveal(ids);
	}

	// mounted images still waiting to load, as { id, el }
	export function getLazyTiles() {
		return [...pending].map((el) => ({ id: el.id, el }));
	}

	onMount(() => {
		onAiMounted?.();
	});

	$effect(() => {
		if (aiBoxWidth && onArtboardChange) {
			const currentArtboard = aiBox.querySelectorAll('.g-artboard')[0];
			if (currentArtboard?.id !== activeArtboard?.id) {
				activeArtboard = untrack(() => currentArtboard);
				onArtboardChange(activeArtboard);
			}
		}
	});
</script>


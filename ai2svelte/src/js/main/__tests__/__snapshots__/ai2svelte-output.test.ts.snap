@mixin shadow-cotija($clr){
$alpha: 1;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: 1px -1px 0 rgba($clr, $alpha), 1px -1px 0 rgba($clr, $alpha), -1px 1px 0 rgba($clr, $alpha), 1px 1px 0 rgba($clr, $alpha);

}

@mixin shadow-halloumi($clr){
$alpha: 1;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: 0px 0px 2px rgba($clr, $alpha);

}

@mixin shadow-pecorino($clr){
$alpha: 0.7;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: 1px 1px 0px rgba($clr, $alpha), -1px -1px 0px rgba($clr, $alpha), -1px 1px 0px rgba($clr, $alpha), 1px -1px 0px rgba($clr, $alpha);

}

@mixin shadow-burrata($clr){
$alpha: 0.5;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: 1px 1px 2px rgba($clr, $alpha);

}

@mixin shadow-raclette($clr){
$alpha: 1;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: rgba($clr, $alpha) 1px 0px 0px,rgba($clr, $alpha) .5px .8px 0px,rgba($clr, $alpha) -.4px .9px 0px,rgba($clr, $alpha) -.98px .14px 0px,rgba($clr, $alpha) -.65px -.75px 0px,rgba($clr, $alpha) .28px -.95px 0px,rgba($clr, $alpha) .96px -.27px 0px;

}

@mixin shadow-olorosoCheese($clr){
$alpha: 1;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: -1px -1px 0 rgba($clr, $alpha), 1px -1px 0 rgba($clr, $alpha), -1px 1px 0 rgba($clr, $alpha), 1px 1px 0 rgba($clr, $alpha);

}

@mixin shadow-pecorino2($clr){
$alpha: 1;
@if color.alpha($clr) != 1 { $alpha: color.alpha($clr); }
text-shadow: 1px 1px 0px rgba($clr, $alpha),-1px 1px 0px rgba($clr, $alpha),1px -1px 0px rgba($clr, $alpha),-1px -1px 0px rgba($clr, $alpha);

}

@mixin shadow-notInLibrary($args...) {}

@mixin animation-pulse($scale: 0.8){
@at-root {
@keyframes pulse { 0%, 100% {transform-box: fill-box; transform-origin: center; transform: scale(1); } 50% {transform-box: fill-box; transform-origin: center; transform: scale(var(--scale)); } }

}
&{
--scale: #{$scale};
}


}

@mixin animation-rotate($degrees: 360deg){
@at-root {
@keyframes rotate { from {transform-box: fill-box; transform-origin: center; transform: rotate(0deg); } to {transform-box: fill-box; transform-origin: center; transform: rotate(var(--degrees)); } }

}
&{
--degrees: #{$degrees};
}


}

@mixin animation-spin($degrees: 360deg){
@at-root {
@keyframes spin { from {transform-box: fill-box; transform-origin: center; transform: rotate(0deg); } to {transform-box: fill-box; transform-origin: center; transform: rotate(var(--degrees)); } }

}
&{
--degrees: #{$degrees};
}


}

@mixin animation-bounce($magnitude: -15px){
@at-root {
@keyframes bounce { 0%, 20%, 53%, 80%, 100% {transform-box: fill-box; transform: translateY(0); } 40%, 43% {transform-box: fill-box; transform: translateY(var(--magnitude)); } 70% {transform-box: fill-box; transform: translateY(calc(var(--magnitude) * 0.5)); } 90% {transform-box: fill-box; transform: translateY(calc(var(--magnitude) * 0.25)); } }

}
&{
--magnitude: #{$magnitude};
}


}

@mixin animation-shake($intensity: 10px){
@at-root {
@keyframes shake { 0%, 100% {transform-box: fill-box; transform: translateX(0); } 10%, 30%, 50%, 70%, 90% {transform-box: fill-box; transform: translateX(calc(var(--intensity) * -1)); } 20%, 40%, 60%, 80% {transform-box: fill-box; transform: translateX(var(--intensity)); } }

}
&{
--intensity: #{$intensity};
}


}

@mixin animation-wobble($magnitude: 5deg){
@at-root {
@keyframes wobble { 0% {transform-box: fill-box; transform-origin: center; transform: translateX(0%) rotate(0deg); } 15% {transform-box: fill-box; transform-origin: center; transform: translateX(-25%) rotate(calc(var(--magnitude) * -1)); } 30% {transform-box: fill-box; transform-origin: center; transform: translateX(20%) rotate(calc(var(--magnitude) * 0.6)); } 45% {transform-box: fill-box; transform-origin: center; transform: translateX(-15%) rotate(calc(var(--magnitude) * -0.6)); } 60% {transform-box: fill-box; transform-origin: center; transform: translateX(10%) rotate(calc(var(--magnitude) * 0.4)); } 75% {transform-box: fill-box; transform-origin: center; transform: translateX(-5%) rotate(calc(var(--magnitude) * -0.2)); } 100% {transform-box: fill-box; transform-origin: center; transform: translateX(0%) rotate(0deg); } }

}
&{
--magnitude: #{$magnitude};
}


}

@mixin animation-jello($magnitude: 12deg){
@at-root {
@keyframes jello { 0%, 11.1%, 100% {transform-box: fill-box; transform-origin: center; transform: skewX(0deg) skewY(0deg); } 22.2% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * -1.04)) skewY(calc(var(--magnitude) * -1.04)); } 33.3% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * 0.52)) skewY(calc(var(--magnitude) * 0.52)); } 44.4% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * -0.26)) skewY(calc(var(--magnitude) * -0.26)); } 55.5% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * 0.13)) skewY(calc(var(--magnitude) * 0.13)); } 66.6% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * -0.065)) skewY(calc(var(--magnitude) * -0.065)); } 77.7% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * 0.0325)) skewY(calc(var(--magnitude) * 0.0325)); } 88.8% {transform-box: fill-box; transform-origin: center; transform: skewX(calc(var(--magnitude) * -0.01625)) skewY(calc(var(--magnitude) * -0.01625)); } }

}
&{
--magnitude: #{$magnitude};
}


}

@mixin animation-flip($perspective: 400px, $translateZ: 150px, $rotate: 360deg){
@at-root {
@keyframes flip { 0% {transform-box: fill-box; transform-origin: center; transform: perspective(var(--perspective)) rotateY(0); } 40% {transform-box: fill-box; transform-origin: center; transform: perspective(var(--perspective)) translateZ(var(--translateZ)) rotateY(calc(var(--rotate) * 0.47)); } 50% {transform-box: fill-box; transform-origin: center; transform: perspective(var(--perspective)) translateZ(var(--translateZ)) rotateY(calc(var(--rotate) * 0.53)) scale(1); } 80% {transform-box: fill-box; transform-origin: center; transform: perspective(var(--perspective)) rotateY(var(--rotate)) scale(0.95); } 100% {transform-box: fill-box; transform-origin: center; transform: perspective(var(--perspective)) scale(1); } }

}
&{
--perspective: #{$perspective};
--translateZ: #{$translateZ};
--rotate: #{$rotate};
}


}

@mixin animation-flash($maxOpacity: 1, $minOpacity: 0){
@at-root {
@keyframes flash { 0%, 50%, 100% { opacity: var(--maxOpacity); } 25%, 75% { opacity: var(--minOpacity); } }

}
&{
--maxOpacity: #{$maxOpacity};
--minOpacity: #{$minOpacity};
}


}

@mixin animation-heartBeat($scale: 1.5){
@at-root {
@keyframes heartBeat { 0% {transform-box: fill-box; transform-origin: center; transform: scale(1); } 14% {transform-box: fill-box; transform-origin: center; transform: scale(calc(1 + (var(--scale) - 1) * 0.87)); } 28% {transform-box: fill-box; transform-origin: center; transform: scale(1); } 42% {transform-box: fill-box; transform-origin: center; transform: scale(calc(1 + (var(--scale) - 1) * 0.87)); } 70% {transform-box: fill-box; transform-origin: center; transform: scale(1); } }

}
&{
--scale: #{$scale};
}


}

@mixin animation-rubberBand($scaleX: 1.25, $scaleY: 0.75){
@at-root {
@keyframes rubberBand { 0% {transform-box: fill-box; transform-origin: center; transform: scale(1); } 30% {transform-box: fill-box; transform-origin: center; transform: scaleX(var(--scaleX)) scaleY(var(--scaleY)); } 40% {transform-box: fill-box; transform-origin: center; transform: scaleX(var(--scaleY)) scaleY(var(--scaleX)); } 50% {transform-box: fill-box; transform-origin: center; transform: scaleX(calc(1 + (var(--scaleX) - 1) * 0.6)) scaleY(calc(1 + (var(--scaleY) - 1) * 0.6)); } 65% {transform-box: fill-box; transform-origin: center; transform: scaleX(calc(1 + (var(--scaleX) - 1) * -0.2)) scaleY(calc(1 + (var(--scaleY) - 1) * -0.2)); } 75% {transform-box: fill-box; transform-origin: center; transform: scaleX(calc(1 + (var(--scaleX) - 1) * 0.2)) scaleY(calc(1 + (var(--scaleY) - 1) * 0.2)); } 100% {transform-box: fill-box; transform-origin: center; transform: scale(1); } }

}
&{
--scaleX: #{$scaleX};
--scaleY: #{$scaleY};
}


}

@mixin animation-dots($scale: 1){
@at-root {
@keyframes dots { 0%, 80%, 100% {transform-box: fill-box; transform-origin: center; scale: 0; } 40% {transform-box: fill-box; transform-origin: center; scale: var(--scale); } }

}
&{
--scale: #{$scale};
}


}

@mixin animation-hueRotate($degrees: 360deg){
@at-root {
@keyframes hueRotate {from {filter: hue-rotate(0deg);} to {filter: hue-rotate(var(--degrees));}}

}
&{
--degrees: #{$degrees};
}


}

@mixin animation-zoomFade($zoom: 2){
@at-root {
@keyframes zoomFade {0% {transform-box: fill-box;transform-origin: center;transform: scale(1);opacity: 1;}100% {transform-box: fill-box;transform-origin: center;transform: scale(var(--zoom));opacity: 0;}}

}
&{
--zoom: #{$zoom};
}


}

@mixin animation-blurFocus($maxBlur: 10px){
@at-root {
@keyframes blurFocus { from { filter: blur(var(--maxBlur)); } to { filter: blur(0); } }

}
&{
--maxBlur: #{$maxBlur};
}


}

@mixin animation-lineProgress($dashArray: 20, $dashGap: 10, $dashOffset: 30){
@at-root {
@keyframes lineProgress {0% {stroke-dashoffset: var(--dashOffset); stroke-dasharray: var(--dashArray) var(--dashGap);} 100% {stroke-dashoffset: 0; stroke-dasharray: var(--dashArray) var(--dashGap);}}

}
&{
--dashArray: #{$dashArray};
--dashGap: #{$dashGap};
--dashOffset: #{$dashOffset};
}


}

@mixin animation-lineGrow($startWidth: 0, $endWidth: 5px){
@at-root {
@keyframes lineGrow { from { stroke-width: var(--startWidth); } to { stroke-width: var(--endWidth); } }

}
&{
--startWidth: #{$startWidth};
--endWidth: #{$endWidth};
}


}

@mixin animation-lineGlow($glowColorStart: red, $glowColorEnd: yellow, $intensity: 10px){
@at-root {
@keyframes lineGlow { from { filter: drop-shadow(0 0 2px var(--glowColorStart)); } to { filter: drop-shadow(0 0 var(--intensity) var(--glowColorEnd)); } }

}
&{
--glowColorStart: #{$glowColorStart};
--glowColorEnd: #{$glowColorEnd};
--intensity: #{$intensity};
}


}

@mixin animation-letterSpacing($startSpacing: 0px, $endSpacing: 5px){
@at-root {
@keyframes letterSpacing { from { letter-spacing: var(--startSpacing); } to { letter-spacing: var(--endSpacing); } }

}
&{
--startSpacing: #{$startSpacing};
--endSpacing: #{$endSpacing};
}


}

@mixin animation-textGlow($shadow: 0 0 10px currentColor){
@at-root {
@keyframes textGlow { from { text-shadow: none; } to { text-shadow: var(--shadow); } }

}
&{
--shadow: #{$shadow};
}


}


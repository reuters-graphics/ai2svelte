}
.g-taggedText:not(:empty)::before {
	content: attr(data-tagged-type);
	position: absolute;
	width: calc(100% + 4px);
	transform: translateY(-100%) translateX(-2px);
	padding: 0px 4px;
	font-size: 0.6rem;
	font-style: normal;
	color: #fff;
	background-color: black;
	display: block;
	font-weight: 800;

{
  "name": "com.reuters-graphics.ai2svelte",
  "private": true,
  "version": "1.0.10",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "watch": "tsc && vite build --watch true",
    "build": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && vite build --watch false",
    "zxp": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZXP_PACKAGE=true vite build --watch false",
    "zip": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZIP_PACKAGE=true vite build --watch false",
    "serve": "cross-env SERVE_PANEL=true vite preview",
    "symlink": "cross-env BOLT_ACTION=symlink vite",
    "delsymlink": "cross-env BOLT_ACTION=delsymlink vite",
    "bake-shadows": "node scripts/bakeShadows.js bake-shadows-raw -- --input=src/js/main/Tabs/data/shadows.json --output=src/js/main/Tabs/data/shadowsBaked.json",
    "bump": "node scripts/bumpVersion.js",
    "check": "pnpm check:frontend && pnpm check:jsx",
    "check:frontend": "node scripts/checkFrontend.js",
    "check:jsx": "node scripts/checkJsx.js",
    "check:es3": "es-check es5 dist/cep/jsx/index.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:visual:generate": "node scripts/visual-test/generate.mjs",
    "test:visual:build-fixtures": "node scripts/visual-test/build-ai-fixtures.mjs",
    "test:visual:preview": "node scripts/visual-test/serve.mjs",
    "replay": "node scripts/replay/replay.mjs",
    "test:visual": "pnpm test:visual:generate && playwright test && vitest run src/js/main/__tests__/ai2svelte-output.test.ts",
    "test:persistence": "node scripts/persistence-test.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/dom": "^1.8.0",
    "@fsegurai/codemirror-theme-bundle": "^6.5.0",
    "@jsquash/webp": "^1.5.0",
    "@tsparticles/confetti": "^3.9.1",
    "bits-ui": "^2.21.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.4",
    "json5": "^2.2.3",
    "postcss": "^8.5.33",
    "postcss-safe-parser": "^7.1.0",
    "prettier": "^3.10.1",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@codemirror/lint": "^6.9.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.12",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "es-check": "^9.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss-discard-empty": "7.0.3",
    "postcss-scss": "^4.0.9",
    "prettier-plugin-svelte": "^4.1.1",
    "process": "0.11.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.3",
    "rollup-plugin-svelte": "^7.2.3",
    "sass": "^1.108.2",
    "svelte": "^5.57.3",
    "svelte-awesome-color-picker": "^4.1.3",
    "svelte-check": "4.2.2",
    "svelte-preprocess": "6.0.5",
    "svooltip": "^0.9.0",
    "types-for-adobe": "^7.2.6",
    "types-for-adobe-extras": "^0.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vite-cep-plugin": "2.2.3",
    "vitest": "^4.1.12"
  }
}
